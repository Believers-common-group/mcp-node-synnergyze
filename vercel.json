{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"genesis\" ]; then exit 1; else exit 0; fi",
  "functions": {
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/compute-plane.ts": {
      "maxDuration": 10
    },
    "api/sites.ts": {
      "maxDuration": 10
    },
    "api/site-handoff.ts": {
      "maxDuration": 10
    },
    "api/mcp.ts": {
      "maxDuration": 60
    },
    "api/registry-bridge.ts": {
      "maxDuration": 60
    },
    "api/authzen-cert.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/compute-plane",
      "destination": "/api/compute-plane"
    },
    {
      "source": "/sites",
      "destination": "/api/sites"
    },
    {
      "source": "/.well-known/estate-sites",
      "destination": "/api/sites"
    },
    {
      "source": "/site-handoff",
      "destination": "/api/site-handoff"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/registry-bridge",
      "destination": "/api/registry-bridge"
    },
    {
      "source": "/.well-known/authzen-configuration",
      "destination": "/api/authzen-cert?route=metadata"
    },
    {
      "source": "/access/v1/evaluation",
      "destination": "/api/authzen-cert?route=evaluation"
    },
    {
      "source": "/access/v1/evaluations",
      "destination": "/api/authzen-cert?route=evaluations"
    },
    {
      "source": "/access/v1/search/subject",
      "destination": "/api/authzen-cert?route=search_subject"
    },
    {
      "source": "/access/v1/search/resource",
      "destination": "/api/authzen-cert?route=search_resource"
    },
    {
      "source": "/access/v1/search/action",
      "destination": "/api/authzen-cert?route=search_action"
    }
  ]
}
