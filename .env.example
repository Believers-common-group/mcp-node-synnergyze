# Remote MCP authentication. Generate a strong random value and store it only in Vercel secrets.
MCP_BEARER_TOKEN=

# Comma-separated browser origins allowed to call the MCP endpoint. Requests without Origin (normal MCP clients) are allowed.
MCP_ALLOWED_ORIGINS=

# Hosted Algolia MCP credentials. Never commit real values.
ALGOLIA_APPLICATION_ID=
ALGOLIA_API_KEY=

# Supabase runtime connection. On Vercel, use the Transaction Pooler (:6543), not the direct :5432 URL.
DATABASE_URL=
