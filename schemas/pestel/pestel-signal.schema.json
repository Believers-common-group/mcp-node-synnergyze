{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtualsilkroad.com/schemas/pestel/pestel-signal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","signalRef","eventRef","vector","confidence","rationales","evidenceRefs","obligationCandidate","classifierVersion"],
  "properties": {
    "schemaVersion": {"const":"PESTEL-SIGNAL:R0.1"},
    "signalRef": {"type":"string"},
    "eventRef": {"type":"string"},
    "vector": {
      "type":"object","additionalProperties":false,
      "required":["political","economic","social","technological","environmental","legal"],
      "properties": {
        "political":{"type":"number","minimum":0,"maximum":1},
        "economic":{"type":"number","minimum":0,"maximum":1},
        "social":{"type":"number","minimum":0,"maximum":1},
        "technological":{"type":"number","minimum":0,"maximum":1},
        "environmental":{"type":"number","minimum":0,"maximum":1},
        "legal":{"type":"number","minimum":0,"maximum":1}
      }
    },
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "rationales":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["dimension","text","evidenceRefs"],"properties":{"dimension":{"enum":["political","economic","social","technological","environmental","legal"]},"text":{"type":"string"},"evidenceRefs":{"type":"array","items":{"type":"string"}}}}},
    "evidenceRefs":{"type":"array","items":{"type":"string"}},
    "obligationCandidate":{"type":"boolean"},
    "classifierVersion":{"const":"PESTEL-CLASSIFIER:R0.1"}
  }
}
