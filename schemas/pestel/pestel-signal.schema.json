{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtualsilkroad.com/schemas/pestel/pestel-signal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","signalRef","legislativeEventRef","vector","riskScore","opportunityScore","obligationCandidate","confidence","rationale","classifierVersion","evidenceRefs"],
  "properties": {
    "schemaVersion": {"const":"PESTEL-SIGNAL:R0.1"},
    "signalRef": {"type":"string"},
    "legislativeEventRef": {"type":"string"},
    "vector": {"type":"object","additionalProperties":false,"required":["political","economic","social","technological","environmental","legal"],"properties":{"political":{"type":"number","minimum":0,"maximum":1},"economic":{"type":"number","minimum":0,"maximum":1},"social":{"type":"number","minimum":0,"maximum":1},"technological":{"type":"number","minimum":0,"maximum":1},"environmental":{"type":"number","minimum":0,"maximum":1},"legal":{"type":"number","minimum":0,"maximum":1}}},
    "riskScore":{"type":"number","minimum":0,"maximum":1},
    "opportunityScore":{"type":"number","minimum":0,"maximum":1},
    "obligationCandidate":{"type":"boolean"},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "rationale":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["dimension","scoreContribution","basis","statement","evidenceRefs","hypothesis"],"properties":{"dimension":{"enum":["political","economic","social","technological","environmental","legal"]},"scoreContribution":{"type":"number","minimum":0,"maximum":1},"basis":{"enum":["DETERMINISTIC_RULE","MODEL_ASSIST"]},"statement":{"type":"string"},"evidenceRefs":{"type":"array","items":{"type":"string"}},"hypothesis":{"type":"boolean"}}}},
    "classifierVersion":{"type":"string"},
    "evidenceRefs":{"type":"array","items":{"type":"string"}}
  }
}
