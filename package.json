{
  "name": "synnergyze-genesis-mcp",
  "version": "0.1.0",
  "main": "src/app.ts",
  "scripts": {
    "start": "node --experimental-transform-types --no-warnings=ExperimentalWarnings src/app.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint --ext .ts src api rc1 compute agent-fabric site-handoff modules",
    "test": "vitest",
    "test:node-builder": "vitest run modules/genesis-node-builder",
    "test:bridge": "vitest run api/registry-bridge.test.ts",
    "test:rc1": "vitest run rc1/runtime.test.ts",
    "test:compute": "vitest run api/compute-plane.test.ts compute/runtime.test.ts",
    "test:compute-proof": "vitest run compute/runtime.test.ts",
    "test:agent": "vitest run agent-fabric/runtime.test.ts",
    "test:agent-action": "vitest run agent-fabric/action-gateway.test.ts",
    "test:contracts": "vitest run modules/contracts.test.ts",
    "test:adapters": "vitest run modules/rc1-adapters.test.ts",
    "test:qel": "vitest run modules/qel/normalizer.test.ts",
    "test:program-bridge": "vitest run modules/synnergyze/program-bridge.test.ts",
    "test:warden-request": "vitest run modules/synnergyze/warden-request-bridge.test.ts",
    "test:warden-decision": "vitest run modules/warden/decision-service.test.ts",
    "test:warden-mcp": "vitest run modules/warden/decision-service.test.ts src/tools/registerWardenConformanceDecision.test.ts src/commands/start-server.warden.test.ts",
    "test:river-reservation": "vitest run modules/river/reservation-service.test.ts",
    "test:warden-river-mcp": "vitest run modules/warden/decision-service.test.ts modules/river/reservation-service.test.ts src/tools/registerRiverWardenConformanceReservation.test.ts src/tools/registerRiverWardenConformanceReservation.review.test.ts src/commands/start-server.river.test.ts",
    "test:warden-river-synnergyze-mcp": "vitest run modules/warden/decision-service.test.ts modules/river/reservation-service.test.ts modules/synnergyze/execution-gate.test.ts src/tools/registerWardenRiverSynnergyzeConformanceExecution.test.ts src/commands/start-server.synnergyze.test.ts",
    "test:warden-river-effect-mcp": "vitest run modules/synnergyze/effect-verification.test.ts modules/rc1-adapters.test.ts src/tools/registerWardenRiverEffectConformance.test.ts src/commands/start-server.effect.test.ts",
    "test:reconciliation-conformance": "vitest run modules/warden/decision-service.test.ts modules/river/reservation-service.test.ts modules/synnergyze/execution-gate.test.ts modules/synnergyze/effect-verification.test.ts src/tools/registerWardenRiverEffectConformance.test.ts src/tools/registerWardenReconciliationConformance.test.ts src/tools/registerWardenReconciliationConformance.review.test.ts src/commands/start-server.reconciliation.test.ts",
    "test:remedy-fabric": "vitest run modules/synnergyze/remedy-fabric.test.ts modules/synnergyze/postgres-remedy-journal.test.ts",
    "test:controlled-execution": "vitest run modules/synnergyze/execution-gate.test.ts",
    "test:containment": "vitest run modules/synnergyze/containment-control.test.ts modules/synnergyze/execution-gate.test.ts",
    "test:effect-verification": "vitest run modules/synnergyze/effect-verification.test.ts",
    "test:objective": "vitest run modules/objective/inventory-transfer.test.ts",
    "test:bag-lock-runtime": "vitest run modules/synnergyze/warden-request-bridge.test.ts modules/synnergyze/execution-gate.test.ts",
    "test:sites": "vitest run api/sites.test.ts",
    "test:site-handoff": "vitest run site-handoff",
    "test:pestel": "vitest run modules/pestel modules/legislative-intelligence modules/river/legislative-evidence.test.ts modules/synnergyze/pestel-work-bridge.test.ts modules/warden/pestel-review-request.test.ts",
    "test:pestel:congress": "vitest run modules/legislative-intelligence/adapters/congress-gov",
    "test:pestel:conformance": "vitest run modules/legislative-intelligence/conformance.test.ts",
    "test:pestel:mcp": "vitest run src/tools/registerPestelLegislativeIngest.test.ts src/tools/registerPestelImpactBrief.test.ts",
    "validate:pestel:congress": "node --experimental-transform-types scripts/validate-congress-gov-runtime.ts",
    "probe:apple-mpp": "bash scripts/bootstrap-apple-mpp-runner.sh",
    "compile:apple-mpp": "bash native/apple-mpp/build-probe.sh",
    "debug": "mcp-inspector npm start"
  },
  "type": "module",
  "keywords": ["mcp", "synnergyze", "genesis", "vsr"],
  "author": "Believers Common Group",
  "license": "MIT",
  "description": "Synnergyze Genesis MCP service for governed VSR/Genesis integrations.",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@neondatabase/serverless": "^1.0.1",
    "ajv": "^8.17.1",
    "algoliasearch": "^5.23.4",
    "commander": "^13.1.0",
    "open": "^10.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@modelcontextprotocol/inspector": "^1.0.1",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^3.1.1",
    "bun": "^1.2.9",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^16.0.0",
    "msw": "^2.7.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": "22.x"
  },
  "prettier": {
    "printWidth": 100
  }
}
