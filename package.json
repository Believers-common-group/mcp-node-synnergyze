{
  "name": "synnergyze-genesis-mcp",
  "version": "0.1.0",
  "main": "src/app.ts",
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings=ExperimentalWarnings src/app.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint --ext .ts src api rc1 compute agent-fabric site-handoff modules",
    "test": "vitest",
    "test:bridge": "vitest run api/registry-bridge.test.ts",
    "test:rc1": "vitest run rc1/runtime.test.ts",
    "test:compute": "vitest run api/compute-plane.test.ts compute/runtime.test.ts",
    "test:compute-proof": "vitest run compute/runtime.test.ts",
    "test:agent": "vitest run agent-fabric/runtime.test.ts",
    "test:contracts": "vitest run modules/contracts.test.ts",
    "test:adapters": "vitest run modules/rc1-adapters.test.ts",
    "test:qel": "vitest run modules/qel/normalizer.test.ts",
    "test:program-bridge": "vitest run modules/synnergyze/program-bridge.test.ts",
    "test:warden-request": "vitest run modules/synnergyze/warden-request-bridge.test.ts",
    "test:warden-decision": "vitest run modules/warden/decision-service.test.ts",
    "test:river-reservation": "vitest run modules/river/reservation-service.test.ts",
    "test:controlled-execution": "vitest run modules/synnergyze/execution-gate.test.ts",
    "test:effect-verification": "vitest run modules/synnergyze/effect-verifier.test.ts",
    "test:sites": "vitest run api/sites.test.ts",
    "test:site-handoff": "vitest run site-handoff/runtime.test.ts",
    "probe:apple-mpp": "bash scripts/bootstrap-apple-mpp-runner.sh",
    "compile:apple-mpp": "bash native/apple-mpp/build-probe.sh",
    "debug": "mcp-inspector npm start"
  },
  "type": "module",
  "keywords": ["mcp", "synnergyze", "genesis", "vsr"],
  "author": "Believers Common Group",
  "license": "ISC",
  "description": "Synnergyze Genesis MCP service for governed VSR/Genesis integrations.",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@neondatabase/serverless": "^1.0.1",
    "ajv": "^8.17.1",
    "algoliasearch": "^5.23.4",
    "commander": "^13.1.0",
    "open": "^10.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@modelcontextprotocol/inspector": "^0.15.0",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^3.1.1",
    "bun": "^1.2.9",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^16.0.0",
    "msw": "^2.7.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": "22.x"
  },
  "prettier": {
    "printWidth": 100
  }
}
