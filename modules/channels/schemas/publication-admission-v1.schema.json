{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtualsilkroad.local/schemas/publication-admission-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestRef", "headerBoardRef", "channelRef", "publisherPrincipalRef", "representedPrincipalRef", "publisherCapacityRef", "contextRef", "programRef", "sourceEventRefs", "classification", "routeRefs", "actionCapabilities", "authorityRefs", "policyRefs", "representationSourceRefs", "evidenceReadinessRef", "requestedAt", "correlationId"],
  "properties": {
    "requestRef": {"type": "string", "minLength": 1},
    "headerBoardRef": {"type": "string", "minLength": 1},
    "channelRef": {"type": "string", "minLength": 1},
    "publisherPrincipalRef": {"type": "string", "minLength": 1},
    "representedPrincipalRef": {"type": "string", "minLength": 1},
    "publisherCapacityRef": {"type": "string", "minLength": 1},
    "contextRef": {"type": "string", "minLength": 1},
    "programRef": {"type": "string", "minLength": 1},
    "sourceEventRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "classification": {"type": "string", "enum": ["PUBLIC", "CUSTOMER", "PARTNER", "WORKFORCE", "MANAGEMENT", "GOVERNED_INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "routeRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "actionCapabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["ACKNOWLEDGE", "COMMENT", "SUBSCRIBE", "REQUEST_ACCESS", "PROPOSE_CHANGE", "OPEN_API", "FORK", "ACCEPT", "REJECT", "REQUEST_REVIEW", "EXECUTE_BOUNDED_ACTION"]}},
    "authorityRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "policyRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "representationSourceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidenceReadinessRef": {"type": "string", "minLength": 1},
    "requestedAt": {"type": "string"},
    "correlationId": {"type": "string", "minLength": 1}
  }
}
