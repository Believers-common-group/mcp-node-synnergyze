{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtualsilkroad.local/schemas/service-route-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["routeRef", "channelRef", "serviceRef", "transport", "endpoint", "status", "allowedClassifications"],
  "properties": {
    "routeRef": {"type": "string", "minLength": 1},
    "channelRef": {"type": "string", "minLength": 1},
    "serviceRef": {"type": "string", "minLength": 1},
    "transport": {"type": "string", "enum": ["IN_MEMORY", "WEB", "APP", "EMAIL", "SMS", "WHATSAPP", "SLACK", "MARKETPLACE_API", "MCP", "PRIVATE_SERVICE"]},
    "endpoint": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["ACTIVE", "INACTIVE"]},
    "allowedClassifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["PUBLIC", "CUSTOMER", "PARTNER", "WORKFORCE", "MANAGEMENT", "GOVERNED_INTERNAL", "CONFIDENTIAL", "RESTRICTED"]}}
  }
}
