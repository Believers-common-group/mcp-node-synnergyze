{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtualsilkroad.local/schemas/publication-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptRef", "headerBoardRef", "channelRef", "routeRef", "sourceEventRefs", "riverReservationRef", "wardenDecisionRef", "state", "payloadDigest", "observedAt", "correlationId"],
  "properties": {
    "receiptRef": {"type": "string", "minLength": 1},
    "headerBoardRef": {"type": "string", "minLength": 1},
    "channelRef": {"type": "string", "minLength": 1},
    "routeRef": {"type": "string", "minLength": 1},
    "sourceEventRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "riverReservationRef": {"type": "string", "minLength": 1},
    "wardenDecisionRef": {"type": "string", "minLength": 1},
    "state": {"type": "string", "enum": ["DELIVERED", "DELIVERY_FAILED", "DELIVERY_UNCERTAIN"]},
    "providerReceiptRef": {"type": "string", "minLength": 1},
    "payloadDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "observedAt": {"type": "string"},
    "correlationId": {"type": "string", "minLength": 1}
  }
}
